# Backend this MCP server drives -- any app exposing:
#   POST /api/generate-lesson, POST /api/question-plan, POST /api/full-video
#   GET  /api/jobs/:id
#   POST /api/cards/generate  (NDJSON stream)
# (Kara Tahta's own contract -- see services/karatahtaClient.js.)
BACKEND_INTERNAL_URL=
# Same shared-secret mechanism as scheduler_worker's SCHEDULER_INTERNAL_TOKEN
# -- the backend must resolve this header to a real user identity server-side.
MCP_BACKEND_TOKEN=

# Port this MCP HTTP server listens on.
PORT=8090

# Required to call THIS server -- any MCP client must send
# `Authorization: Bearer <MCP_SERVER_ACCESS_TOKEN>`. Without this, anyone who
# finds the URL could trigger paid lesson/card generation on your backend.
MCP_SERVER_ACCESS_TOKEN=

# How long generate_lesson_video waits (polling /api/jobs/:id) before
# returning early with { status: "running", jobId } instead of the final
# result. The job itself keeps running server-side either way -- this only
# bounds how long the tool CALL blocks the caller.
MCP_LESSON_WAIT_MS=240000
# Same idea for generate_cards -- cards aren't job-based (no jobId to poll
# later), so past this budget the tool returns whatever cards finished with
# status:"partial" instead of blocking indefinitely.
MCP_CARDS_WAIT_MS=120000
