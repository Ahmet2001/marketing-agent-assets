# Backend this scheduler drives -- any app that exposes:
#   POST /api/cards/generate, POST /api/cards/sessions/:id/publish-instagram
#   POST /api/generate-lesson, GET /api/jobs/:id, POST /api/social-publish
# (Kara Tahta's own contract; see services/scheduler.js for the exact calls.)
# Auth is a shared secret header, not a user session -- the backend must
# resolve X-Scheduler-Token to SCHEDULER_USER_ID's identity.
BACKEND_INTERNAL_URL=
SCHEDULER_INTERNAL_TOKEN=
SCHEDULER_USER_ID=

# scheduler_jobs table -- see migrations/001_scheduler_jobs.sql
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# content_pool.txt storage: one idea/question per line, read in order with
# a per-job_type cursor. Any S3-compatible bucket (Railway Bucket, R2, etc).
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
MEDIA_S3_URL_STYLE=virtual-host
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=

# Optional tuning (defaults shown)
SCHEDULER_TICK_MS=60000
SCHEDULER_JOB_TIMEOUT_MS=900000
SCHEDULER_COMBO_GAP_MS=600000
SCHEDULER_VIDEO_SEGMENT_COUNT=8
SCHEDULER_VIDEO_MINUTES=10
