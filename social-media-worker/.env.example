# Default queue adapter: shared Supabase database
SUPABASE_URL=
SUPABASE_SECRET_KEY=
QUEUE_ADAPTER_MODULE=supabase
# For another queue, point to an ESM module exporting claimNextJob, finishJob,
# and failJob. Relative paths are resolved from the project directory.
# QUEUE_ADAPTER_MODULE=./my-queue-adapter.js

# Publishing credentials: configure only the platforms you use.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_API_VERSION=v21.0
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_TOKEN_URI=https://oauth2.googleapis.com/token
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# Queue polling
SOCIAL_PUBLISH_POLL_MS=5000
# Comma-separated allowlist for video URLs. Leave blank to allow every HTTPS host.
ALLOWED_VIDEO_HOSTS=

# Optional multi-tenant credential provider. If omitted, the static platform
# credentials above are used. It receives {jobId, credentialRef, platforms}
# and must respond with {credentials:{instagram?,youtube?,tiktok?}}.
CREDENTIALS_PROVIDER_URL=
CREDENTIALS_PROVIDER_TOKEN=
